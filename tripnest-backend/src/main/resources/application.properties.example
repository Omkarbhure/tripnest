spring.application.name=tripnest-backend
server.port=8081

# Database Configuration (PostgreSQL / MySQL)
spring.datasource.url=jdbc:postgresql://localhost:5432/tripnest
spring.datasource.username=postgres
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# JWT Security
jwt.secret=YOUR_JWT_SECRET_KEY_MIN_32_CHARACTERS_LONG
jwt.expiration=86400000

# OpenWeather API
openweather.api.key=YOUR_OPENWEATHER_API_KEY
openweather.api.url=https://api.openweathermap.org/data/2.5/weather

# OpenStreetMap / Nominatim API
nominatim.api.url=https://nominatim.openstreetmap.org/search